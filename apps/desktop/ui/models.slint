export enum NavigationPage {
    home,
    subscriptions,
    purchase,
    profile,
    settings,
    about,
}

export enum AppPhase {
    restoring,
    signed-out,
    signed-in,
}

export enum ResourcePhase {
    idle,
    loading,
    refreshing,
    ready,
    failed,
}

export enum ShopPhase {
    idle,
    loading,
    ready,
    failed,
}

export enum ConnectionPhase {
    disconnected,
    preparing,
    validating,
    starting,
    connected,
    stopping,
    failed,
}

export enum SubscriptionStatus {
    active,
    expired,
    exhausted,
    disabled,
}

export struct ResourceGroupItem {
    id: string,
