export component DesignSystemPreview inherits Window {
    title: "TOPNODE · 界面组件预览";
    preferred-width: 900px;
    preferred-height: 620px;
    background: AppTheme.canvas;

    VerticalLayout {
        padding: 32px;
        spacing: 20px;
        HorizontalLayout {
            BrandLockup { mark-size: 40px; show-product-type: true; }
            Rectangle { horizontal-stretch: 1; background: transparent; }
            StatusDot { fill: AppTheme.accent; }
        }
        PageHeader {
            title: "界面组件";
            subtitle: "颜色、控件与交互状态";
        }
        SurfaceCard {
            VerticalLayout {
                padding: 24px;
                spacing: 18px;
                HorizontalLayout {
                    spacing: 12px;
                    AppButton { text: "主要操作"; }
                    AppButton { text: "次要操作"; kind: ButtonKind.secondary; }
                    AppButton { text: "文本操作"; kind: ButtonKind.ghost; }
                    AppButton { text: "不可用"; enabled: false; }
                    Rectangle { horizontal-stretch: 1; background: transparent; }
                    BusyIndicator { }
                }
                HorizontalLayout {
                    spacing: 12px;
                    AppField { width: 260px; placeholder: "输入内容"; }
                    AppSwitch { checked: true; }
                    AppSwitch { checked: false; }
                    CountryMark { code: "JP"; }
                    CountryMark { code: "DE"; }
                    Rectangle { horizontal-stretch: 1; background: transparent; }
                }
                InlineAlert { message: "这是需要用户关注的重要提示。"; danger: false; }
                InlineAlert { message: "操作未完成，请检查后重试。"; }
                HorizontalLayout {
                    spacing: 20px;
                    for icon-name in ["home", "subscriptions", "shop", "data-usage", "refresh", "empty-subscriptions", "nodes", "settings", "info", "user", "globe", "bolt", "play", "stop", "lock", "chevron-right"] : Glyph {
                        name: icon-name;
                        fill: AppTheme.accent-dark;
                    }
                }
            }
        }
        Rectangle { vertical-stretch: 1; background: transparent; }
    }
}
