export component TelemetryDynamicPreview inherits ConnectedPreview {
    property <bool> show-large-values: false;
    download-rate: root.show-large-values ? "999.9 GiB/s" : "0 B/s";
    upload-rate: root.show-large-values ? "1 B/s" : "82.4 MiB/s";
    active-connections: root.show-large-values ? 2147483647 : 0;
    runtime-memory: root.show-large-values ? "1024.0 GiB" : "--";

    Timer {
        interval: 900ms;
        triggered => { root.show-large-values = !root.show-large-values; }
    }
}

