    in-out property <bool> gift-card-checking: false;
    in-out property <bool> gift-card-redeeming: false;
    in-out property <string> gift-card-check-error;
    in-out property <string> gift-card-redeem-error;
    in-out property <bool> gift-card-has-check: false;
    in-out property <bool> gift-card-can-redeem: false;
    in-out property <string> gift-card-check-reason;
    in-out property <GiftCardRewardItem> gift-card-reward;
    in-out property <bool> gift-card-redeemed: false;
    in-out property <bool> invitation-visible: false;
    in-out property <bool> invitation-loading: false;
    in-out property <bool> invitation-has-summary: false;
    in-out property <string> invitation-error;
    in-out property <bool> invitation-enabled: true;
    in-out property <string> invitation-available-commission: "¥0.00";
    in-out property <string> invitation-total-commission: "¥0.00";
    in-out property <string> invitation-cooling-commission: "¥0.00";
    in-out property <string> invitation-rate: "0%";
    in-out property <string> invitation-count: "0 人";
    in-out property <string> invitation-code;
    in-out property <string> invitation-url;
    in-out property <[AffiliateCommissionItem]> invitation-commissions;
    in-out property <bool> invitation-commissions-loading: false;
    in-out property <bool> invitation-commissions-loading-more: false;
    in-out property <string> invitation-commissions-error;
    in-out property <bool> invitation-commissions-has-more: false;
    in-out property <int> invitation-commissions-page: 1;
    in-out property <int> invitation-commissions-total: 0;
    in-out property <[AffiliateTransferItem]> invitation-transfers;
    in-out property <bool> invitation-transfers-loading: false;
    in-out property <bool> invitation-transfers-loading-more: false;
    in-out property <string> invitation-transfers-error;
    in-out property <bool> invitation-transfers-has-more: false;
    in-out property <int> invitation-transfers-page: 1;
    in-out property <int> invitation-transfers-total: 0;
    in-out property <bool> subscription-link-visible: false;
    in-out property <bool> subscription-link-loading: false;
    in-out property <bool> subscription-link-has-link: false;
    in-out property <string> subscription-link-error;
    in-out property <string> subscription-link-url;
    in-out property <bool> subscription-link-resetting: false;
    in-out property <string> subscription-link-reset-error;
    in-out property <bool> tickets-visible: false;
    in-out property <string> tickets-mode: "list";
    in-out property <[SupportTicketItem]> support-tickets;
