import { SettingsPage } from "pages/settings-page.slint";
import { AboutSlint } from "std-widgets.slint";

component NoticeToast inherits Rectangle {
    in property <string> message;
    callback dismissed();

    changed message => {
        dismiss-timer.restart();
    }

    width: 520px;
    height: 54px;
    border-radius: AppTheme.radius-medium;
    background: #18342b;
    border-width: 1px;
    border-color: #ffffff1f;
    drop-shadow-color: #10231c38;
    drop-shadow-blur: 18px;
    drop-shadow-offset-y: 5px;

    dismiss-timer := Timer {
        interval: 2s;
        triggered => {
            self.stop();
            root.dismissed();
        }
    }

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 8px;
        spacing: 12px;

        VerticalLayout {
            width: 4px;
            alignment: center;
            Rectangle {
                width: 4px;
                height: 22px;
                border-radius: 2px;
                background: #69d4af;
            }
        }

        Text {
            horizontal-stretch: 1;
            text: root.message;
            color: #f7fffb;
            font-size: 12px;
            font-weight: 500;
            wrap: word-wrap;
            vertical-alignment: center;
        }

        VerticalLayout {
            width: 52px;
            alignment: center;
            close-button := Rectangle {
                width: 48px;
                height: 32px;
                border-radius: AppTheme.radius-small;
                background: close-touch.pressed ? #ffffff20
                    : close-touch.has-hover ? #ffffff14 : transparent;
                animate background { duration: 100ms; }

                Text {
                    text: "关闭";
                    color: #dff7ed;
                    font-size: 12px;
                    font-weight: 600;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                close-touch := TouchArea {
                    mouse-cursor: MouseCursor.pointer;
                    clicked => { root.dismissed(); }
                }
            }
        }
    }
}

export component StartupErrorWindow inherits Window {
    in-out property <string> error-message;
    in-out property <bool> retrying: false;
    callback retry();

    title: "TOPNODE - 启动失败";
    icon: @image-url("assets/topnode-logo.svg");
    default-font-family: "Microsoft YaHei UI";
    preferred-width: 480px;
    preferred-height: 310px;
    min-width: 480px;
    min-height: 310px;
    max-width: 480px;
    max-height: 310px;
    background: AppTheme.canvas;

    VerticalLayout {
        padding: 28px;
        spacing: 18px;

        Text {
            text: "暂时无法启动 TOPNODE";
            color: AppTheme.ink;
            font-size: 20px;
            font-weight: 700;
        }

        Text {
            text: root.retrying ? "正在重新获取启动配置并检测服务……" : root.error-message;
            color: root.retrying ? AppTheme.ink-muted : AppTheme.danger;
            font-size: 13px;
            wrap: word-wrap;
            vertical-stretch: 1;
        }

        Text {
            text: "请确认网络连接正常，然后重试。";
            color: AppTheme.ink-subtle;
            font-size: 12px;
        }

        HorizontalLayout {
            alignment: end;
            spacing: 10px;

            AppButton {
                text: "退出";
                kind: ButtonKind.secondary;
                enabled: !root.retrying;
                clicked => { root.close(); }
            }

            AppButton {
                text: root.retrying ? "正在重试" : "重试";
                busy: root.retrying;
                enabled: !root.retrying;
                clicked => { root.retry(); }
            }
        }
    }
}

export component AppWindow inherits Window {
    in property <bool> administrator-mode: false;
    title: root.administrator-mode ? "TOPNODE - 管理员模式运行" : "TOPNODE";
    icon: @image-url("assets/topnode-logo.svg");
    default-font-family: "Microsoft YaHei UI";
    preferred-width: 1024px;
    preferred-height: 720px;
    min-width: 1024px;
    min-height: 720px;
    max-width: 1024px;
    max-height: 720px;
    background: AppTheme.canvas;

    in property <AppPhase> app-phase: AppPhase.restoring;
    in property <bool> login-submitting: false;
    in property <string> login-error;
    in property <string> user-display-name;
    in property <string> user-email;
    in property <string> user-balance-label: "¥0.00";
    in property <int> user-balance-cents: 0;
    in-out property <bool> account-settings-visible: false;
    in-out property <bool> account-settings-busy: false;
    in-out property <string> account-settings-error;
    in-out property <string> account-settings-stage: "overview";
    in-out property <bool> balance-details-visible: false;
