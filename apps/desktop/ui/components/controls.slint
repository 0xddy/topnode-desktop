import { SmoothCard } from "./smooth-card.slint";
import { AppTheme } from "../theme.slint";
import { Glyph } from "glyph.slint";

export enum ButtonKind {
    primary,
    secondary,
    ghost,
}

export component BusyIndicator inherits Rectangle {
    in property <color> indicator-color: AppTheme.accent;
    width: 18px;
    height: 18px;
    background: transparent;

    Rectangle {
        width: 100%;
        height: 100%;
        border-radius: root.width / 2;
        border-width: 2px;
        border-color: root.indicator-color.with-alpha(0.22);
        background: transparent;
    }
    Rectangle {
        x: root.width / 2 - 2px + cos(360deg * animation-tick() / 900ms) * (root.width / 2 - 2px);
        y: root.height / 2 - 2px + sin(360deg * animation-tick() / 900ms) * (root.height / 2 - 2px);
        width: 4px;
        height: 4px;
        border-radius: 2px;
        background: root.indicator-color;
    }
}

export component RefreshIconButton inherits Rectangle {
    in property <bool> busy;
    in property <string> icon: "refresh";
    callback clicked();

    width: 38px;
    height: 38px;
    border-radius: AppTheme.radius-control;
    border-width: 1px;
    border-color: AppTheme.border;
    background: root.busy ? AppTheme.surface-subtle
        : refresh-touch.pressed ? AppTheme.surface-muted
        : refresh-touch.has-hover ? AppTheme.accent-faint : AppTheme.surface;
    animate background { duration: 100ms; easing: ease-out; }

    if root.busy : BusyIndicator {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 18px;
        height: 18px;
    }

    if !root.busy : Glyph {
        x: 10px;
        y: 10px;
        name: root.icon;
        fill: refresh-touch.has-hover ? AppTheme.accent : AppTheme.ink-muted;
    }

    refresh-touch := TouchArea {
        enabled: !root.busy;
        mouse-cursor: root.busy ? MouseCursor.default : MouseCursor.pointer;
        clicked => { root.clicked(); }
    }
}

export component AppButton inherits Rectangle {
    in property <string> text;
    in property <ButtonKind> kind: ButtonKind.primary;
    in property <bool> enabled: true;
    in property <bool> busy: false;
    in property <bool> filled-secondary: false;
    in property <color> primary-color: AppTheme.accent;
    in property <color> primary-hover-color: AppTheme.accent-hover;
    in property <color> primary-pressed-color: AppTheme.accent-dark;
    in property <bool> gradient-primary: false;
    in property <length> button-min-width: 80px;
    in property <length> corner-radius: AppTheme.radius-control;
    out property <bool> has-focus: button-focus.has-focus;
    callback clicked();
    callback key-pressed(KeyEvent) -> EventResult;
    key-pressed(event) => { return reject; }

    forward-focus: button-focus;
    accessible-role: button;
    accessible-label: root.text;
    accessible-enabled: root.enabled && !root.busy;
    accessible-action-default => {
        if root.enabled && !root.busy { root.clicked(); }
    }

    min-width: root.button-min-width;
    height: 40px;
    border-radius: root.corner-radius;
    opacity: root.enabled ? 1 : 0.42;
    background: root.kind == ButtonKind.primary ? (touch.pressed ? root.primary-pressed-color
            : touch.has-hover && root.enabled ? root.primary-hover-color
            : root.gradient-primary
                ? @linear-gradient(90deg, root.primary-hover-color 0%, root.primary-color 100%)
                : root.primary-color)
        : root.kind == ButtonKind.secondary ? (touch.pressed ? #dedfe0
            : touch.has-hover && root.enabled ? #e7e8e9
            : root.filled-secondary ? #ededef : AppTheme.surface)
        : touch.pressed ? AppTheme.surface-muted
            : touch.has-hover && root.enabled ? AppTheme.surface-muted : transparent;
    border-width: root.kind == ButtonKind.secondary && !root.filled-secondary ? 1px : 0px;
    border-color: AppTheme.border;
    animate background { duration: 120ms; }

    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        alignment: center;
        spacing: 8px;
        if root.busy : VerticalLayout {
            width: 16px;
            alignment: center;
            BusyIndicator {
                width: 16px;
                height: 16px;
                indicator-color: root.kind == ButtonKind.primary ? white : AppTheme.accent;
            }
        }
        Text {
            text: root.text;
            accessible-role: none;
            color: root.kind == ButtonKind.primary ? white
                : root.kind == ButtonKind.ghost ? AppTheme.ink-muted : AppTheme.ink;
            font-size: 13px;
            font-weight: 600;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        enabled: root.enabled && !root.busy;
        mouse-cursor: self.enabled ? MouseCursor.pointer : MouseCursor.default;
        clicked => {
            button-focus.focus();
            root.clicked();
        }
    }
    button-focus := FocusScope {
        x: 0px;
        width: 0px;
        enabled: root.enabled && !root.busy;
        key-pressed(event) => {
            if root.key-pressed(event) == accept { return accept; }
            if event.text == " " || event.text == Key.Return {
                if root.enabled && !root.busy { root.clicked(); }
                return accept;
            }
            return reject;
        }
    }
    if root.has-focus && root.enabled && !root.busy : Rectangle {
        x: -3px;
        y: -3px;
        width: parent.width + 6px;
        height: parent.height + 6px;
        border-radius: root.corner-radius + 3px;
        border-width: 2px;
        border-color: AppTheme.accent.with-alpha(0.5);
        background: transparent;
    }
}

export component AppField inherits Rectangle {
    in property <string> placeholder;
    in-out property <string> text;
    in property <bool> enabled: true;
    in property <InputType> input-type: InputType.text;
    in property <length> trailing-inset: 0px;
    callback accepted(string);
    callback edited();

    height: 44px;
    border-radius: AppTheme.radius-control;
    forward-focus: input;
    background: input.has-focus ? AppTheme.surface : AppTheme.field;
    border-width: 1px;
    border-color: input.has-focus ? AppTheme.accent : transparent;
    animate background { duration: 120ms; }
    animate border-color { duration: 120ms; }

    Text {
        x: 14px;
        width: parent.width - 28px - root.trailing-inset;
        height: 100%;
        visible: input.text == "";
        text: root.placeholder;
        color: AppTheme.ink-subtle;
        font-size: 14px;
        vertical-alignment: center;
    }

    input := TextInput {
        x: 14px;
        width: parent.width - 28px - root.trailing-inset;
        height: 100%;
        text <=> root.text;
        enabled: root.enabled;
        input-type: root.input-type;
        single-line: true;
        color: AppTheme.ink;
        font-size: 14px;
        vertical-alignment: center;
        accepted => { root.accepted(self.text); }
        edited => { root.edited(); }
    }
}

export component AppCheckBox inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    in-out property <bool> checked;
    callback toggled();

    width: 104px;
    height: 36px;
    background: transparent;
    opacity: root.enabled ? 1 : 0.45;
    forward-focus: check-focus;
    accessible-role: checkbox;
    accessible-label: root.text;
    accessible-checkable: true;
    accessible-checked: root.checked;
    accessible-enabled: root.enabled;
    accessible-action-default => { root.toggle(); }

    function toggle() {
        if root.enabled {
            root.checked = !root.checked;
            root.toggled();
        }
    }

    box := Rectangle {
        x: 0px;
        y: (parent.height - self.height) / 2;
        width: 18px;
        height: 18px;
        border-radius: 5px;
        border-width: 1.5px;
        border-color: root.checked || check-touch.has-hover ? AppTheme.accent : AppTheme.border-strong;
        background: root.checked ? (check-touch.pressed ? AppTheme.accent-dark : AppTheme.accent)
            : check-touch.has-hover ? AppTheme.accent-faint : AppTheme.surface;
        animate background, border-color { duration: 120ms; }
        if root.checked : Image {
            width: 18px;
            height: 18px;
            source: @image-url("../assets/icons/controls-app-check-box.svg");
            colorize: white;
        }
    }
    Text {
        x: 28px;
        width: parent.width - self.x;
        height: parent.height;
        text: root.text;
        color: root.checked ? AppTheme.ink : AppTheme.ink-muted;
        font-size: 13px;
        vertical-alignment: center;
    }
    check-touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? MouseCursor.pointer : MouseCursor.default;
        clicked => { check-focus.focus(); root.toggle(); }
    }
    check-focus := FocusScope {
        x: 0px;
        width: 0px;
        enabled: root.enabled;
        key-pressed(event) => {
            if event.text == " " || event.text == Key.Return {
                root.toggle();
                return accept;
            }
            return reject;
        }
    }
    if check-focus.has-focus && root.enabled : Rectangle {
        x: box.x - 3px;
        y: box.y - 3px;
        width: 24px;
        height: 24px;
        border-radius: 8px;
        border-width: 2px;
        border-color: AppTheme.accent.with-alpha(0.25);
        background: transparent;
    }
}

export component AppSwitch inherits Rectangle {
    in-out property <bool> checked;
    in property <bool> checked-visible: true;
    in property <bool> enabled: true;
    callback toggled();

    forward-focus: switch-focus;
    accessible-role: checkbox;
    accessible-checkable: true;
    accessible-checked: root.checked && root.checked-visible;
    accessible-enabled: root.enabled;
    accessible-action-default => { root.toggle(); }

    function toggle() {
        if root.enabled {
            root.checked = !root.checked;
            root.toggled();
        }
    }

    width: 42px;
    height: 26px;
    border-radius: 13px;
    opacity: root.enabled ? 1 : 0.45;
    background: root.checked && root.checked-visible ? AppTheme.accent : AppTheme.border-strong;
    animate background { duration: 150ms; }

    Rectangle {
        x: root.checked && root.checked-visible ? root.width - self.width - 3px : 3px;
        y: 3px;
        width: 20px;
        height: 20px;
        border-radius: 10px;
        background: white;
        drop-shadow-color: #00000026;
        drop-shadow-blur: 4px;
        drop-shadow-offset-y: 1px;
        animate x { duration: 150ms; easing: ease-out; }
    }

    TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? MouseCursor.pointer : MouseCursor.default;
        clicked => {
            switch-focus.focus();
            root.toggle();
        }
    }
    switch-focus := FocusScope {
        x: 0px;
        width: 0px;
        enabled: root.enabled;
        key-pressed(event) => {
            if event.text == " " || event.text == Key.Return {
                root.toggle();
                return accept;
            }
            return reject;
        }
    }
    if switch-focus.has-focus && root.enabled : Rectangle {
        x: -3px;
        y: -3px;
        width: parent.width + 6px;
        height: parent.height + 6px;
        border-radius: 16px;
        border-width: 2px;
        border-color: AppTheme.accent.with-alpha(0.5);
        background: transparent;
    }
}

export component PageHeader inherits VerticalLayout {
    in property <string> title;
    in property <string> subtitle;
    in property <length> title-size: 26px;
    spacing: 4px;

    Text {
        text: root.title;
        color: AppTheme.ink;
        font-size: root.title-size;
        font-weight: 600;
    }
    Text {
        text: root.subtitle;
        color: AppTheme.ink-muted;
        font-size: 13px;
    }
}

export component SurfaceCard inherits SmoothCard {
    border-radius: AppTheme.radius-large;
    background: AppTheme.surface;
    outline-color: AppTheme.border;
    drop-shadow-color: #10231c0a;
    drop-shadow-blur: 12px;
    drop-shadow-offset-y: 3px;
}

export component Hairline inherits Rectangle {
    height: 1px;
    background: AppTheme.border;
    horizontal-stretch: 1;
}

export component StatusDot inherits Rectangle {
    in property <color> fill: AppTheme.ink-subtle;
    width: 7px;
    height: 7px;
    border-radius: 3.5px;
    background: root.fill;
}

export component CountryMark inherits Rectangle {
    in property <string> code;
    in property <bool> active: true;
    width: 36px;
    height: 36px;
    border-radius: 10px;
    background: root.active ? AppTheme.accent-soft : AppTheme.surface-muted;

    Text {
        text: root.code == "" ? "--" : root.code;
        color: root.active ? AppTheme.accent-dark : AppTheme.ink-subtle;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 0.4px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

export component InlineAlert inherits Rectangle {
    in property <string> message;
    in property <bool> danger: true;
    min-height: 40px;
    border-radius: AppTheme.radius-small;
    background: root.danger ? AppTheme.danger-soft : AppTheme.warning-soft;

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        padding-top: 10px;
        padding-bottom: 10px;
        spacing: 10px;
        VerticalLayout {
            width: 7px;
            alignment: center;
            StatusDot { fill: root.danger ? AppTheme.danger : AppTheme.warning; }
        }
        Text {
            text: root.message;
            color: root.danger ? AppTheme.danger : AppTheme.warning;
            font-size: 12px;
            wrap: word-wrap;
            vertical-alignment: center;
        }
    }
}
