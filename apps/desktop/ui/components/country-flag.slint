import { AppTheme } from "../theme.slint";
import { Glyph } from "glyph.slint";

export component CountryFlag inherits Rectangle {
    in property <string> code;
    width: 42px;
    height: 42px;
    border-radius: root.width / 2;
    background: transparent;
    clip: true;

    Glyph {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        name: "globe";
        fill: AppTheme.accent;
        width: 20px;
        height: 20px;
    }

    if root.code == "AD" : Image {
        width: 100%;
        height: 100%;
        source: @image-url("../assets/flags/flag_ad.webp");
        image-fit: cover;
    }
