        if root.code == "YE" { return @image-url("../assets/flags/flag_ye.webp"); }
        if root.code == "YT" { return @image-url("../assets/flags/flag_yt.webp"); }
        if root.code == "ZA" { return @image-url("../assets/flags/flag_za.webp"); }
        if root.code == "ZM" { return @image-url("../assets/flags/flag_zm.webp"); }
        if root.code == "ZW" { return @image-url("../assets/flags/flag_zw.webp"); }
        return root.empty-image;
    }

    property <image> flag-image: {
        let flag-a = root.flag-group-a();
        if flag-a.width > 0 { return flag-a; }
        let flag-b = root.flag-group-b();
        if flag-b.width > 0 { return flag-b; }
        let flag-c = root.flag-group-c();
        if flag-c.width > 0 { return flag-c; }
        let flag-d = root.flag-group-d();
        if flag-d.width > 0 { return flag-d; }
        let flag-e = root.flag-group-e();
        if flag-e.width > 0 { return flag-e; }
        let flag-f = root.flag-group-f();
        if flag-f.width > 0 { return flag-f; }
        let flag-g = root.flag-group-g();
        if flag-g.width > 0 { return flag-g; }
        let flag-h = root.flag-group-h();
        if flag-h.width > 0 { return flag-h; }
        let flag-i = root.flag-group-i();
        if flag-i.width > 0 { return flag-i; }
        let flag-j = root.flag-group-j();
        if flag-j.width > 0 { return flag-j; }
        let flag-k = root.flag-group-k();
        if flag-k.width > 0 { return flag-k; }
        let flag-l = root.flag-group-l();
        if flag-l.width > 0 { return flag-l; }
        let flag-m = root.flag-group-m();
        if flag-m.width > 0 { return flag-m; }
        let flag-n = root.flag-group-n();
        if flag-n.width > 0 { return flag-n; }
        let flag-o = root.flag-group-o();
        if flag-o.width > 0 { return flag-o; }
        let flag-p = root.flag-group-p();
        if flag-p.width > 0 { return flag-p; }
        return root.empty-image;
    }

    if root.flag-image.width > 0 : Image {
        width: 100%;
        height: 100%;
        source: root.flag-image;
        image-fit: cover;
    }
    if root.flag-image.width == 0 : Glyph {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        name: "globe";
        fill: AppTheme.accent;
        width: 20px;
        height: 20px;
    }
}
