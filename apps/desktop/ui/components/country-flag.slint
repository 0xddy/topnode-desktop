import { AppTheme } from "../theme.slint";
import { Glyph } from "glyph.slint";

export component CountryFlag inherits Rectangle {
    in property <string> code;
    width: 42px;
    height: 42px;
    border-radius: root.width / 2;
    background: transparent;
    clip: true;

    // Use exactly one image. A fallback behind a translucent flag bleeds
    // through when the parent node is disabled or the flag has transparent areas.
    property <image> empty-image;
    pure function flag-group-a() -> image {
        if root.code == "AD" { return @image-url("../assets/flags/flag_ad.webp"); }
