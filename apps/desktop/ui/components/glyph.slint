import { AppTheme } from "../theme.slint";

export component Glyph inherits Rectangle {
    in property <string> name: "home";
    in property <color> fill: AppTheme.ink;
    width: 18px;
    height: 18px;
    background: transparent;

    if root.name == "home" : Image {
        width: 18px;
        height: 18px;
        source: @image-url("../assets/icons/glyph-home.svg");
        colorize: root.fill;
    }

    if root.name == "nodes" : Rectangle {
        background: transparent;
        Rectangle { x: 1px; y: 1px; width: 7px; height: 7px; border-radius: 2px; background: root.fill; }
        Rectangle { x: 10px; y: 1px; width: 7px; height: 7px; border-radius: 2px; background: root.fill; }
        Rectangle { x: 1px; y: 10px; width: 7px; height: 7px; border-radius: 2px; background: root.fill; }
        Rectangle { x: 10px; y: 10px; width: 7px; height: 7px; border-radius: 2px; background: root.fill; }
    }

    if root.name == "subscriptions" : Rectangle {
        background: transparent;
        Image {
            width: 18px;
            height: 18px;
            source: @image-url("../assets/icons/glyph-subscriptions.svg");
            colorize: root.fill;
        }
    }

    if root.name == "shop" : Rectangle {
        background: transparent;
        Image {
            width: 18px;
            height: 18px;
            source: @image-url("../assets/icons/glyph-shop.svg");
            colorize: root.fill;
        }
    }

    if root.name == "package" : Image {
        width: 18px;
        height: 18px;
        source: @image-url("../assets/icons/glyph-package.svg");
        colorize: root.fill;
    }

    if root.name == "coupon" : Image {
        width: 18px;
        height: 18px;
        source: @image-url("../assets/icons/glyph-coupon.svg");
        colorize: root.fill;
    }

    if root.name == "data-usage" : Rectangle {
        background: transparent;
        Image {
            width: 18px;
            height: 18px;
            source: @image-url("../assets/icons/glyph-data-usage.svg");
            colorize: root.fill;
        }
    }

    if root.name == "refresh" : Image {
        width: 18px;
        height: 18px;
        source: @image-url("../assets/icons/glyph-refresh.svg");
        colorize: root.fill;
    }

    if root.name == "copy" : Image {
        width: root.width;
        height: root.height;
        source: @image-url("../assets/icons/glyph-copy.svg");
        colorize: root.fill;
    }

    if root.name == "support" : Image {
        width: 24px;
        height: 24px;
        source: @image-url("../assets/icons/glyph-support.svg");
        colorize: root.fill;
    }

    if root.name == "send" : Image {
        width: 24px;
        height: 24px;
        source: @image-url("../assets/icons/glyph-send.svg");
        colorize: root.fill;
    }

    if root.name == "plus" : Image {
        width: 24px;
        height: 24px;
        source: @image-url("../assets/icons/glyph-plus.svg");
        colorize: root.fill;
    }

    if root.name == "more" : Image {
        width: 24px;
        height: 24px;
        source: @image-url("../assets/icons/glyph-more.svg");
        colorize: root.fill;
    }

    if root.name == "error" : Image {
        width: 24px;
        height: 24px;
        source: @image-url("../assets/icons/glyph-error.svg");
        colorize: root.fill;
    }

    if root.name == "empty-subscriptions" : Rectangle {
        background: transparent;
        Image {
            width: 18px;
            height: 18px;
            source: @image-url("../assets/icons/glyph-empty-subscriptions.svg");
            colorize: root.fill;
        }
    }

    if root.name == "settings" : Image {
        width: 18px;
        height: 18px;
        source: @image-url("../assets/icons/glyph-settings.svg");
        colorize: root.fill;
    }

    if root.name == "info" : Rectangle {
        background: transparent;
        Rectangle {
            x: 1px;
            y: 1px;
            width: 16px;
            height: 16px;
            border-radius: 8px;
            border-width: 1.8px;
            border-color: root.fill;
            background: transparent;
        }
        Rectangle { x: 8px; y: 5px; width: 2px; height: 2px; border-radius: 1px; background: root.fill; }
        Rectangle { x: 8px; y: 8.5px; width: 2px; height: 5px; border-radius: 1px; background: root.fill; }
    }

    if root.name == "clock" : Rectangle {
        background: transparent;
        Rectangle {
            x: 1px;
            y: 1px;
            width: 16px;
            height: 16px;
            border-radius: 8px;
            border-width: 1.7px;
            border-color: root.fill;
            background: transparent;
        }
        Image {
            width: 18px;
            height: 18px;
            source: @image-url("../assets/icons/glyph-clock.svg");
            colorize: root.fill;
        }
    }

    if root.name == "user" : Rectangle {
        background: transparent;
        Rectangle { x: 6px; y: 2px; width: 6px; height: 6px; border-radius: 3px; background: root.fill; }
        Rectangle { x: 3px; y: 10px; width: 12px; height: 7px; border-radius: 6px; background: root.fill; }
    }

    if root.name == "play" : Image {
        width: 18px;
        height: 18px;
        source: @image-url("../assets/icons/glyph-play.svg");
        colorize: root.fill;
    }

    if root.name == "bolt" : Image {
        width: 18px;
        height: 18px;
        source: @image-url("../assets/icons/glyph-bolt.svg");
        colorize: root.fill;
    }

    if root.name == "globe" : Rectangle {
        background: transparent;
        Rectangle {
            x: 1px;
            y: 1px;
            width: 16px;
            height: 16px;
            border-radius: 8px;
            border-width: 1.6px;
            border-color: root.fill;
            background: transparent;
        }
        Rectangle {
            x: 6px;
            y: 1px;
            width: 6px;
            height: 16px;
            border-radius: 3px;
            border-width: 1.2px;
            border-color: root.fill;
            background: transparent;
        }
        Rectangle { x: 2px; y: 8px; width: 14px; height: 1.2px; background: root.fill; }
    }

    if root.name == "stop" : Rectangle {
        x: 5px;
        y: 5px;
        width: 8px;
        height: 8px;
        border-radius: 2px;
        background: root.fill;
    }

    if root.name == "logout" : Image {
        width: 18px;
        height: 18px;
        source: @image-url("../assets/icons/glyph-logout.svg");
        colorize: root.fill;
    }

    if root.name == "check" : Image {
        width: root.width;
        height: root.height;
        source: @image-url("../assets/icons/glyph-check.svg");
        colorize: root.fill;
    }

    if root.name == "lock" : Rectangle {
        background: transparent;
        Rectangle {
            x: root.width / 2 - 4.5px;
            y: root.height * 0.05;
            width: 9px;
            height: 11px;
            border-radius: 4.5px;
            border-width: 2px;
            border-color: root.fill;
            background: transparent;
        }
        Rectangle {
            x: root.width / 2 - 7px;
            y: root.height * 0.42;
            width: 14px;
            height: 10px;
            border-radius: 3px;
            background: root.fill;
        }
    }

    if root.name == "chevron-right" : Image {
        width: root.width;
        height: root.height;
        source: @image-url("../assets/icons/glyph-chevron-right.svg");
        colorize: root.fill;
    }

    if root.name == "arrow-left" : Image {
        width: root.width;
        height: root.height;
        source: @image-url("../assets/icons/glyph-arrow-left.svg");
        colorize: root.fill;
    }

    if root.name == "eye" : Rectangle {
        background: transparent;

        Image {
            width: root.width;
            height: root.height;
            source: @image-url("../assets/icons/glyph-eye.svg");
            colorize: root.fill;
        }
        Rectangle {
            x: root.width / 2 - 2.6px;
            y: root.height / 2 - 2.6px;
            width: 5.2px;
            height: 5.2px;
            border-radius: 2.6px;
            background: root.fill;
        }
    }

    if root.name == "eye-off" : Rectangle {
        background: transparent;

        Image {
            width: root.width;
            height: root.height;
            source: @image-url("../assets/icons/glyph-eye-off.svg");
            colorize: root.fill;
        }
    }
}
